# Copy to .env and fill in. .env is gitignored.
# NEVER commit .env — it contains passwords and secrets.

# ---- Runtime environment ----
# development | production
ENVIRONMENT=development

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- SQL Server ----
# Adjust to your local SQL Server instance. The API expects the Gold schema
# (from sql/gold/) and the api_audit schema (from scripts/setup_audit_schema.sql)
# in the same database.
SQL_SERVER=Ryzen7PC\SQLEXPRESS
SQL_DATABASE=pymeconta_local
SQL_USER=sa
SQL_PASSWORD=replace-me
SQL_DRIVER={ODBC Driver 17 for SQL Server}
# Azure SQL: SQL_ENCRYPT=yes y SQL_TRUST_SERVER_CERTIFICATE=no. Local (SQL Express): no / yes.
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_POOL_SIZE=10

# ---- JWT ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Set true in prod to disable mock header fallback for /chat auth.
AUTH_REQUIRE_JWT=false

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Rate limiting (sliding window in-memory; Redis in v0.2) ----
RATE_LIMIT_TENANT_HOUR=100
RATE_LIMIT_USER_HOUR=30
RATE_LIMIT_TOKENS_DAY=1000000

# ---- Service-to-service auth (sub-fase 6.1) ----
# Shared secret between this API and ERP backends (e.g. .NET Balaxys proxy).
# Leave empty to disable service auth (dev mode). Never commit the real value.
SERVICE_KEY=
# Set true in production to reject all non-service requests (no Bearer JWT / mock).
SERVICE_MODE=false

# ---- Balaxys ERP via MCP (chat interno como cliente MCP) — docs/mcp-client.md ----
# Endpoint /mcp de la API Balaxys del mismo ambiente. Vacio = solo flujo retail.
# local: https://localhost:7173/mcp (con BALAXYS_MCP_VERIFY_TLS=false)
BALAXYS_MCP_URL=
BALAXYS_MCP_ENABLED=true
BALAXYS_MCP_TIMEOUT_SECONDS=30
BALAXYS_MCP_MAX_TOOL_CALLS=8
BALAXYS_MCP_ROLE_SUBSET=true
# false SOLO contra https://localhost con certificado de desarrollo.
BALAXYS_MCP_VERIFY_TLS=true

# ---- Modo solo ERP (docs/deploy-azure-dev.md) ----
# false = sin tools retail (almacen gold) ni prompt retail: el chat usa solo las tools ERP via MCP.
RETAIL_TOOLS_ENABLED=true

# ---- PostgreSQL (producto independiente — NO CAMBIAR para clientes Balaxys)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=asistente-ia
PG_USER=postgres
PG_PASSWORD=postgres
# Tenants que usan PostgreSQL (separados por coma si hay más de uno)
PG_TENANTS=24

# ---- Super admin (ejecutar 003_seed_superadmin.py para crear)
# Nunca hardcodear en codigo — solo en .env
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-strong-password

# ---- CORS (orígenes permitidos, separados por coma) ----
# En desarrollo: localhost del frontend Vite
# En producción: URL del Azure Static Web App
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Conversational memory ----
# User+assistant message pairs loaded from DB per request (higher = more context, more tokens)
MEMORY_TURNS_PER_REQUEST=3
